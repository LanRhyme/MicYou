{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MicYou",
  "mainBinaryName": "micyou",
  "version": "2.1.0",
  "identifier": "com.lanrhyme.micyou",
  "build": {
    "beforeDevCommand": "bun run prepare-sidecars:dev && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run sync-version && bun run prepare-sidecars && bun run build",
    "beforeBundleCommand": "bun run clean-bundles",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "MicYou",
        "width": 800,
        "height": 600,
        "decorations": false,
        "resizable": false,
        "transparent": true,
        "shadow": false,
        "windowEffects": {
          "effects": [
            "acrylic",
            "blur"
          ]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Music",
    "externalBin": [
      "binaries/micyou-cli",
      "binaries/micyou-tui"
    ],
    "resources": [
      "resources/*",
      "resources/alsa/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
