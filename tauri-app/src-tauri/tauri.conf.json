{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MicYou",
  "mainBinaryName": "micyou",
  "version": "2.0.3",
  "identifier": "com.lanrhyme.micyou",
  "build": {
    "beforeDevCommand": "npm run build-tray-icon && npm run prepare-sidecars:dev && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run sync-version && npm run build-tray-icon && npm run prepare-sidecars && npm run build",
    "beforeBundleCommand": "npm run clean-bundles && npm run build-macos-icon && npm run build-dmg-background",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "MicYou",
        "width": 800,
        "height": 600,
        "decorations": false,
        "resizable": false,
        "transparent": true,
        "shadow": false,
        "windowEffects": {
          "effects": [
            "acrylic",
            "blur"
          ]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Music",
    "externalBin": [
      "binaries/micyou-cli",
      "binaries/micyou-tui"
    ],
    "resources": [
      "resources/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "files": {
        "Resources/Assets.car": "icons/Assets.car",
        "Resources/zh-Hans.lproj": "packaging/InfoPlist/zh-Hans.lproj",
        "Resources/zh-Hant.lproj": "packaging/InfoPlist/zh-Hant.lproj",
        "Resources/zh-HK.lproj": "packaging/InfoPlist/zh-HK.lproj"
      },
      "dmg": {
        "background": "packaging/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 180
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 180
        }
      }
    }
  }
}
