{
  "id": "dev.micyou.example.soundpad",
  "name": "Example Soundpad",
  "version": "1.0.0",
  "author": "MicYou",
  "description": "示例音效板：按钮面板 + 专属设置页（postMessage 桥）+ 全局快捷键（Ctrl+Shift+S），音效经虚拟麦克风输出流播放",
  "runtime": "native",
  "entry": "libmicyou_example_native_soundpad.so",
  "platforms": [
    "linux",
    "windows",
    "macos"
  ],
  "apiVersion": 1,
  "capabilities": [
    "config.read",
    "config.write",
    "audio.play"
  ],
  "kind": "utility",
  "ui": {
    "route": "buttons",
    "label": "Soundpad",
    "panels": [
      {
        "id": "console",
        "label": "控制台",
        "entry": "panel.html"
      },
      {
        "id": "stats",
        "label": "状态",
        "entry": "stats.html",
        "sidebar": false
      }
    ]
  },
  "config": {
    "sounds": []
  },
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/LanRhyme/MicYou",
  "keywords": [
    "soundpad",
    "example",
    "utility"
  ],
  "nameI18n": {
    "zh-CN": "音效板"
  },
  "repository": "https://github.com/MicYou-Dev/MicYou-Plugins"
}